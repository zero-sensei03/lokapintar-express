// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum Role {
  SUPERADMIN
  ADMIN
  EDUCATOR
  CREATOR
  CONSUMER
}
enum OTPType {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_EMAIL
}
enum StorageProvider {
  LOCAL
  S3
  GCS
  SUPABASE
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  ROLE_CHANGE
  STATUS_CHANGE
  EXPORT
  IMPORT
  OTHER
}


enum ContentType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

enum TransactionType {
  TOPUP
  EDUCATOR_SUBSCRIPTION
  AI_GENERATE_FEE
  COURSE_PURCHASE
  MARKETPLACE_PURCHASE
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Media {
  id          String          @id @default(uuid())
  filename    String          // Nama file asli dari user saat diunggah
  key         String          @unique // Path/Key unik di storage (e.g. "avatars/uuid.webp")
  url         String          // Public URL untuk mengakses file
  mimetype    String          // Contoh: "image/webp", "image/gif"
  size        Int             // Ukuran file dalam bytes
  provider    StorageProvider // Menyimpan driver storage yang digunakan saat upload

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userAvatar  UserProfile?           @relation("UserAvatar")
  userBanner  UserProfile?           @relation("UserBanner")

  @@index([provider])
}
model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  passwordHash          String

  role                  Role        @default(CONSUMER)
  status                UserStatus  @default(INACTIVE)

  emailVerifiedAt       DateTime?
  lastSuspendedAt       DateTime?
  educatorSubExpiresAt  DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  profile               UserProfile?
  audit                 AuditLog[]

  @@index([email])
  @@index([role])
}
model UserProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Data Identitas & Bio
  fullName      String
  bio           String?   @db.Text
  headline      String?   // Contoh: "Serial Entrepreneur | Ex-Tech Lead"
  phoneNumber   String?

  // address
  location      String?   // Contoh: "Jakarta, Indonesia" // domisili
  address       String?   @db.Text
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  zipPortal     String?
  
  // Preferensi Startup
  interests     String[]  // Contoh: ["Fintech", "AI/ML", "EdTech", "SaaS"]
  skills        String[]  // Contoh: ["React", "Go", "Product Management", "Marketing"]

  // Media (Avatar & Cover Banner)
  avatarId      String?   @unique
  avatar        Media?    @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  
  bannerId      String?   @unique
  banner        Media?    @relation("UserBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  // Social & Portfolio Links
  websiteUrl    String?
  linkedinUrl   String?
  githubUrl     String?
  twitterUrl    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
model OtpVerification {
  id            String    @id @default(uuid())
  email         String
  otpHash       String
  otpType       OTPType

  expiredAt     DateTime
  createdAt     DateTime  @default(now())

  @@unique([email, otpType])
}
model AuditLog {
  id            String      @id @default(uuid())

  userId        String?
  action        AuditAction
  resource      String
  resourceId    String?

  description   String?     @db.Text

  oldValues     Json?
  newValues     Json?
  metadata      Json?

  ipAddress     String?
  userAgent     String?
  requestId     String?

  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([requestId])
}