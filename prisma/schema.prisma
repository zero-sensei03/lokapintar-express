// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  SUPERADMIN
  EDUCATOR
  CREATOR
  CONSUMER
}

enum OTPType {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_EMAIL
}

enum StorageProvider {
  LOCAL
  S3
  GCS
  SUPABASE
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

enum TransactionType {
  TOPUP
  EDUCATOR_SUBSCRIPTION
  AI_GENERATE_FEE
  COURSE_PURCHASE
  MARKETPLACE_PURCHASE
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Media {
  id          String          @id @default(uuid())
  filename    String          // Nama file asli dari user saat diunggah
  key         String          @unique // Path/Key unik di storage (e.g. "avatars/uuid.webp")
  url         String          // Public URL untuk mengakses file
  mimetype    String          // Contoh: "image/webp", "image/gif"
  size        Int             // Ukuran file dalam bytes
  provider    StorageProvider // Menyimpan driver storage yang digunakan saat upload

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userAvatar  User?           @relation("UserAvatar")

  @@index([provider])
}
model User {
  id                    String      @id @default(uuid())
  name                  String
  email                 String      @unique
  passwordHash          String
  role                  Role        @default(CONSUMER)
  status                UserStatus  @default(INACTIVE)
  emailVerifiedAt       DateTime?
  lastSuspendedAt       DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  educatorSubExpiresAt  DateTime?

  avatarId  String?     @unique
  avatar    Media?      @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role])
}

model OtpVerification {
  id            String    @id @default(uuid())
  email         String
  otpHash       String
  otpType       OTPType

  expiredAt     DateTime
  createdAt     DateTime  @default(now())

  @@unique([email, otpType])
}